# Base URL of the Fattor API. Each user signs in on the login page; the server keeps no API token.
FATTOR_API_BASE_URL=https://symphony.fattorcredito.com.br/public/prova-dev

# The only credential the login page accepts. These are the public demo credentials published in
# the API's Swagger documentation; in a deploy, replace them with the credential you want to allow.
# The demo API accepts any email and password, so the app itself lets only this one through.
SIGN_IN_EMAIL=demo@prova.dev
SIGN_IN_PASSWORD=demo123
